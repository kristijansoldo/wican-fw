  ;; ============================================================
  ;; NET CONNECTIONS (Signal flow description)
  ;; ============================================================
  ;;
  ;; POWER:
  ;; OBD2 Pin16 (+12V) -> D2 -> D1 -> C1 -> U1(IN)
  ;; U1(OUT/5V) -> C2 -> U2(IN) -> U4(VCC)
  ;; U2(OUT/3.3V) -> C4 -> U3(VDD)
  ;;
  ;; CAN BUS (ESP32 TWAI direct):
  ;; U3.GPIO4 (TWAI_TX) -> U4.TXD
  ;; U3.GPIO5 (TWAI_RX) <- U4.RXD
  ;; U3.GPIO38 -> U4.STB (standby control)
  ;; U4.CANH -> R4 -> D4 -> OBD2 Pin6
  ;; U4.CANL -> R5 -> D4 -> OBD2 Pin14
  ;;
  ;; STATUS LED:
  ;; U3.GPIO42 -> R6(1K) -> D5(Green) -> GND
  ;;
  ;; RESET:
  ;; 3V3 -> R3(10K) -> EN -> C7(100nF) -> GND
  ;;
  ;; GROUND:
  ;; OBD2 Pin4/Pin5 -> GND plane
  ;;

