    (property "Description" "ESP32-S3-MINI-1-N8, 8MB Flash, PCB antenna, WiFi+BLE5, TWAI CAN" (at 195.58 114.3 0) (effects (font (size 1.27 1.27)) hide))
    ;; PRV-LINK v2.0 Pin Assignments (TWAI direct, no STN1110):
    ;; GPIO4  = TWAI_TX (to CAN transceiver TXD)
    ;; GPIO5  = TWAI_RX (from CAN transceiver RXD)
    ;; GPIO38 = CAN_STDBY (CAN transceiver standby control)
    ;; GPIO42 = LED_EN (status LED)
    ;; GPIO0  = BOOT (active low, optional button for firmware flash)
    ;; EN     = Enable (with RC reset circuit)
    ;;
    ;; Free GPIOs: 1,2,3,6,7,8,9,10,11,12,13,14,21,39,40,41,47,48
    ;; (Available for future expansion: UART debug, I2C sensors, etc.)
  )

